limit_req_zone $binary_remote_addr zone=one:10m rate=90r/m;

server {
    
    server_name tame-files-change-sleepily.st.a.dcdg.xyz; 

    # BLOK 1: Tangani Certbot (Prioritas Tertinggi)
    # Ini akan menangani http://.../.well-known/acme-challenge/
    location ^~ /.well-known/acme-challenge/ {
        alias /var/www/html/.well-known/acme-challenge/;
        default_type "text/plain";
    }

    # BLOK 2: Tangani /threads (Kriteria 3)
    location ~ ^/threads(/.*)?$ {
        limit_req zone=one;

        proxy_pass http://localhost:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # BLOK 3: Tangani semua request lain (misal: /users, /authentications)
    location ~ / {
        proxy_pass http://localhost:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/tame-files-change-sleepily.st.a.dcdg.xyz/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/tame-files-change-sleepily.st.a.dcdg.xyz/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = tame-files-change-sleepily.st.a.dcdg.xyz) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    
    server_name tame-files-change-sleepily.st.a.dcdg.xyz www.tame-files-change-sleepily.st.a.dcdg.xyz;
    return 404; # managed by Certbot


}
